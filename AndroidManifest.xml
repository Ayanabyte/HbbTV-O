<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="es.ayana.tdtlab" android:versionCode="6" android:versionName="0.1.5">
  <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="30"/>
  <uses-feature android:name="android.software.leanback" android:required="true"/>
  <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
  <uses-permission android:name="android.permission.READ_TV_LISTINGS"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <queries>
    <package android:name="com.tcl.android.webview"/>
  </queries>
  <application android:label="O! TDT Lab" android:icon="@drawable/lab" android:banner="@drawable/lab" android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
    <uses-library android:name="com.tcl.hbbtv.HbbtvServer" android:required="false"/>
    <uses-library android:name="tcl.webkit" android:required="false"/>
    <uses-library android:name="com.tcl.tbrowser" android:required="false"/>
    <uses-library android:name="com.tcl.tvmanager" android:required="false"/>
    <uses-library android:name="com.tcl.os.system" android:required="false"/>
    <uses-library android:name="com.tcl.deviceinfo" android:required="false"/>
    <activity android:name=".Lab" android:exported="true" android:screenOrientation="landscape">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
    </activity>
  </application>
</manifest>
