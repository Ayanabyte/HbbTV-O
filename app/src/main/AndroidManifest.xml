<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <package android:name="com.tcl.android.webview" />
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.tvinput" />
    </queries>

    <application
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:label="HbbTV O!"
        android:use32bitAbi="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <uses-library android:name="com.tcl.hbbtv.HbbtvServer" android:required="false" />
        <uses-library android:name="com.tcl.tbrowser" android:required="false" />
        <uses-library android:name="com.tcl.os.system" android:required="false" />
        <uses-library android:name="com.tcl.deviceinfo" android:required="false" />
        <uses-native-library android:name="libsitatv.so" android:required="false" />
        <uses-library android:name="com.tcl.tvmanager" android:required="false" />
        <uses-native-library android:name="libcom_tcl_hbbtv_jni.tcl.so" android:required="false" />
        <uses-native-library android:name="libcom_tcl_tbrowser_jni.tcl.so" android:required="false" />

        <activity
            android:name="com.ayanabyte.hbbtvo.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
